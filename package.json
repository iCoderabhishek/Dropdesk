{
  "name": "dropdesk",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/api/server.ts",
    "generate": "bunx --bun prisma generate",
    "migrate": "bunx --bun prisma migrate dev",
    "studio": "bunx --bun prisma studio",
    "docker": "docker compose up -d --build",
    "docker-dev": "docker compose up -d --build",
    "docker-down": "docker compose down",
    "docker-volumes-down": "docker compose down -v",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun eslint .",
    "format": "bunx --bun prettier --write .",
    "replace-logger": "node scripts/replace_logger.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bun": "latest",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "author": "Abhishek Jha",
  "url": "https://github.com/iCoderabhishek/Dropdesk.git",
  "description": "Create workspace and share media accross team members",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/lib-storage": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1083.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "archiver": "^8.0.0",
    "axios": "^1.18.1",
    "bullmq": "^5.80.4",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "prisma": "^7.8.0",
    "rate-limit-redis": "^6.0.0",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}